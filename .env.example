# Supabase Environment Configuration
# Copy this file to .env and fill in your Supabase credentials:
# cp .env.example .env
#
# Run the application using:
# flutter run --dart-define-from-file=.env

# Switch active database: 'staging' (Testing DB) or 'production' (Real DB)
APP_ENV=staging

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional staging overrides
SUPABASE_STAGING_URL=https://your-staging-project.supabase.co
SUPABASE_STAGING_ANON_KEY=your-staging-anon-key
